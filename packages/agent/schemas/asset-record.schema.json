{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumino.example/schemas/asset-record/0.1.0",
  "title": "Lumino Enterprise Data Asset Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "versionId", "revision", "type", "schemaVersion", "frameworkVersion", "tenantId", "ownerOrganizationId", "name", "status", "payload", "provenance", "quality", "access", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "versionId": { "type": "string", "minLength": 3 },
    "revision": { "type": "integer", "minimum": 1 },
    "parentVersionId": { "type": ["string", "null"] },
    "type": { "type": "string", "enum": ["organization", "organizationUnit", "facility", "product", "productVariant", "process", "productionLine", "counterparty", "evidence", "measurement", "energyConsumption", "materialFlow", "productionOutput", "transportActivity", "wasteActivity", "shipmentEvent", "supplierDeclaration", "certificate", "referenceData", "dataset"] },
    "schemaVersion": { "type": "string" },
    "frameworkVersion": { "type": "string" },
    "tenantId": { "type": "string", "minLength": 1 },
    "ownerOrganizationId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": { "type": "string", "enum": ["DRAFT", "PROPOSED", "NEEDS_CONFIRMATION", "CONFIRMED", "CONFLICTED", "SUPERSEDED", "ARCHIVED"] },
    "subjectRefs": { "type": "object" },
    "temporal": { "type": "object" },
    "payload": { "type": "object" },
    "provenance": { "type": "object", "required": ["sourceType", "sourceAssetIds"], "properties": { "sourceType": { "type": "string" }, "sourceAssetIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } },
    "quality": { "type": "object" },
    "access": { "type": "object", "required": ["confidentiality", "visibility"], "properties": { "confidentiality": { "type": "string", "enum": ["general", "internal", "sensitive", "highly_sensitive"] }, "visibility": { "type": "string", "enum": ["enterprise", "restricted", "service_bound"] }, "allowedRoles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } },
    "steward": { "type": "object" },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },
    "createdByRole": { "type": "string" },
    "reason": { "type": "string" }
  }
}
