{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumino.example/schemas/snapshot/0.2.0",
  "title": "Lumino Service Calculation Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "serviceId", "caseId", "bindingIds", "inputAssetVersionIds", "status", "locked", "createdAt", "createdBy"],
  "properties": {
    "id": { "type": "string" },
    "tenantId": { "type": ["string", "null"] },
    "serviceId": { "type": "string" },
    "caseId": { "type": "string" },
    "bindingIds": { "type": "array", "items": { "type": "string" } },
    "inputAssetVersionIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "transformationIds": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["OPEN", "CURRENT", "LOCKED", "STALE", "SUPERSEDED"] },
    "locked": { "type": "boolean" },
    "lockedAt": { "type": ["string", "null"], "format": "date-time" },
    "lockedBy": { "type": ["string", "null"] },
    "impactAlerts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "assetVersionId": { "type": "string" },
          "newVersionId": { "type": ["string", "null"] },
          "message": { "type": "string" }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },
    "createdByRole": { "type": "string" },
    "reason": { "type": "string" }
  }
}
