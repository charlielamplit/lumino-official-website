{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumino.example/schemas/calculation-run/0.2.0",
  "title": "Lumino Service Calculation Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "serviceId", "caseId", "snapshotId", "inputAssetVersionIds", "status", "createdAt", "createdBy"],
  "properties": {
    "id": { "type": "string" },
    "tenantId": { "type": ["string", "null"] },
    "serviceId": { "type": "string" },
    "caseId": { "type": "string" },
    "snapshotId": { "type": "string" },
    "inputAssetVersionIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "ruleVersion": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CURRENT", "STALE", "SUPERSEDED"] },
    "resultSummary": { "type": "object" },
    "workflowObjectId": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string" },
    "createdByRole": { "type": "string" },
    "reason": { "type": "string" }
  }
}
