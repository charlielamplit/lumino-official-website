{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumino.example/schemas/authorization-decision/1.0.0",
  "title": "Lumino Authorization Decision Audit Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventType", "occurredAt", "outcome", "reasonCode", "actorId", "tenantId", "capability", "annualProjectId", "objectRef"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "eventType": { "const": "AUTHORIZATION_DECIDED" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "outcome": { "type": "string", "enum": ["ALLOWED", "DENIED"] },
    "reasonCode": { "type": "string", "minLength": 1 },
    "actorId": { "type": ["string", "null"] },
    "tenantId": { "type": ["string", "null"] },
    "capability": { "type": ["string", "null"] },
    "annualProjectId": { "type": ["string", "null"] },
    "objectRef": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "revision"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "revision": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}
