{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumino.example/schemas/api-error-response/1.0.0",
  "title": "Lumino Platform API Error Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "contractVersion", "requestId", "error"],
  "properties": {
    "ok": { "const": false },
    "contractVersion": { "const": "1.0.0" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "messageKey", "message", "retryable", "recovery"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_FAILED",
            "AUTH_REQUIRED",
            "TENANT_FORBIDDEN",
            "CAPABILITY_FORBIDDEN",
            "RESOURCE_NOT_FOUND",
            "METHOD_NOT_ALLOWED",
            "REVISION_CONFLICT",
            "RATE_LIMITED",
            "DEPENDENCY_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "messageKey": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "recovery": {
          "type": "string",
          "enum": ["CORRECT_INPUT", "SIGN_IN", "CONTACT_ADMIN", "RETURN_TO_LIST", "NONE", "REFRESH_RESOURCE", "RETRY_LATER"]
        },
        "retryAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "fieldErrors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "code", "messageKey"],
            "properties": {
              "field": { "type": "string", "minLength": 1, "maxLength": 160 },
              "code": { "type": "string", "minLength": 1, "maxLength": 80 },
              "messageKey": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        }
      }
    }
  }
}
