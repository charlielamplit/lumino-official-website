# 线索通知（可选；未配置时仍落库，Portal 线索箱可查看）
# POST JSON 的 CRM / 飞书机器人 / Zapier / Make 等
LEAD_WEBHOOK_URL=https://example.com/lumino-leads

# Resend 邮件通知（可选，与 Webhook 可并存）
LEAD_NOTIFY_EMAIL=ops@example.com
LEAD_NOTIFY_FROM=Lumino Leads <onboarding@resend.dev>
RESEND_API_KEY=

# 生产环境建议设置；未设置时 GET/PATCH /api/leads 对同源开放（原型）
LEADS_STAFF_KEY=

# 官网顾问 API（F08-03/F08-04）。
# 未配置 Key 时：确定性路由 + 已发布知识本地检索（无模型）。
# 配置后：仅在确定性未命中且检索到已发布来源时调用模型；无来源则停止。
OPENAI_API_KEY=
ADVISOR_OPENAI_API_KEY=
# OpenAI-compatible gateway, e.g. https://aiberm.com/v1
ADVISOR_OPENAI_BASE_URL=https://api.openai.com/v1
# responses | chat ; empty = responses for api.openai.com else chat
ADVISOR_OPENAI_API_MODE=
# aiberm 示例：anthropic/claude-haiku-5.5 、deepseek/deepseek-v4-flash
# OpenAI 渠道可用后再改回 openai/gpt-4.1-nano / openai/gpt-4.1-mini
# Sol 须选快模型；超时会回退 Luna 一次
ADVISOR_MODEL_LUNA=anthropic/claude-haiku-5.5
ADVISOR_MODEL_SOL=deepseek/deepseek-v4-flash
# api_no_store | provider_contract_required | unknown ；空=按 Base URL / API mode 推断
ADVISOR_STORAGE_POLICY=

# GitHub Roadmap / Issue 同步（固定目标仓库）
GITHUB_OWNER=charlielamplit
GITHUB_REPO=lumino-official-website
# 可使用 fine-grained PAT；仅写入本地 .env。
# Repository permissions 至少需要 Metadata: Read 和 Issues: Read and write。
GITHUB_TOKEN=

# F08-06 public beta controls
# 1/true = show Ask Lumino; 0/false = hide entry (tools remain)
ADVISOR_PUBLIC_BETA=1
# 1/true = allow model when key present; 0/false = kill-switch to fixed/tool/retrieval-only
ADVISOR_MODEL_ENABLED=1
# Staff key for GET /api/advisor-metrics (preferred). Falls back to LEADS_STAFF_KEY if unset.
ADVISOR_STAFF_KEY=

# Aligned timeouts (model must finish before client abandons)
ADVISOR_CLIENT_TIMEOUT_MS=15000
ADVISOR_MODEL_TIMEOUT_MS=12000
ADVISOR_LUNA_TIMEOUT_MS=12000
ADVISOR_SOL_TIMEOUT_MS=12000
