# 线索通知（可选；未配置时仍落库，Portal 线索箱可查看）
# 企业微信群机器人（推荐）。格式：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=…
WECOM_WEBHOOK_URL=
# 公网站点根地址，用于企微消息中的「打开线索收件箱」链接
PUBLIC_SITE_URL=https://www.luminoyou.cn
# 通用 Webhook（CRM / Zapier 等）。若填企微 URL，也会按企微 markdown 发送
LEAD_WEBHOOK_URL=

# Resend 邮件通知（后置；与企微可并存）
LEAD_NOTIFY_EMAIL=ops@example.com
LEAD_NOTIFY_FROM=Lumino Leads <onboarding@resend.dev>
RESEND_API_KEY=

# 员工登录与线索读写
# STAFF_USERS=ops@lumino.tech:password:ops:林晓,sales@lumino.tech:password:sales:陈宇
STAFF_USERS=
LEADS_STAFF_KEY=

# 官网顾问 API（F08-03/F08-04）。
# 未配置 Key 时：确定性路由 + 已发布知识本地检索（无模型）。
# 配置后：仅在确定性未命中且检索到已发布来源时调用模型；无来源则停止。
OPENAI_API_KEY=
ADVISOR_OPENAI_API_KEY=
# OpenAI-compatible gateway, e.g. https://aiberm.com/v1
ADVISOR_OPENAI_BASE_URL=https://api.openai.com/v1
# responses | chat ; empty = responses for api.openai.com else chat
ADVISOR_OPENAI_API_MODE=
# Optional HTTPS Advisor origin for environments that cannot reach the model provider directly.
# The local API applies input validation, privacy guards and context allowlisting before forwarding.
ADVISOR_UPSTREAM_URL=
# aiberm 示例：anthropic/claude-haiku-5.5 、deepseek/deepseek-v4-flash
# OpenAI 渠道可用后再改回 openai/gpt-4.1-nano / openai/gpt-4.1-mini
# Sol 须选快模型；超时会回退 Luna 一次
ADVISOR_MODEL_LUNA=gpt-6-luna
ADVISOR_MODEL_SOL=deepseek/deepseek-v4-flash
ADVISOR_LUNA_ENABLED=0
ADVISOR_GROUNDED_MODEL_ENABLED=0
# api_no_store | provider_contract_required | unknown ；空=按 Base URL / API mode 推断
ADVISOR_STORAGE_POLICY=

# GitHub Roadmap / Issue 同步（固定目标仓库）
GITHUB_OWNER=charlielamplit
GITHUB_REPO=lumino-official-website
# 可使用 fine-grained PAT；仅写入本地 .env。
# Repository permissions 至少需要 Metadata: Read 和 Issues: Read and write。
GITHUB_TOKEN=

# F08-06 public beta controls
# 1/true = show Ask Lumino; 0/false = hide entry (tools remain)
ADVISOR_PUBLIC_BETA=1
# 1/true = allow model when key present; 0/false = kill-switch to fixed/tool/retrieval-only
ADVISOR_MODEL_ENABLED=1
# Staff key for GET /api/advisor-metrics (preferred). Falls back to LEADS_STAFF_KEY if unset.
ADVISOR_STAFF_KEY=

# Aligned timeouts (model must finish before client abandons)
ADVISOR_CLIENT_TIMEOUT_MS=22000
ADVISOR_MODEL_TIMEOUT_MS=18000
ADVISOR_LUNA_TIMEOUT_MS=18000
ADVISOR_SOL_TIMEOUT_MS=18000

# PostgreSQL phase-1 platform foundation
# LEADS_STORE=postgres requires DATABASE_URL; never falls back to JSON/memory.
DATABASE_URL=postgres://lumino@127.0.0.1:5432/lumino_platform
# 客户 Portal 身份默认关闭；完成迁移与管理员配号后才启用。
# PORTAL_AUTH_ENABLED=1
# PORTAL_CUSTOMER_EMAIL=owner@example.com
# PORTAL_CUSTOMER_PASSWORD=请使用至少12位随机密码
# PORTAL_CUSTOMER_NAME=企业管理员
# PORTAL_TENANT_SLUG=example-company
# PORTAL_TENANT_NAME=示例企业
# PORTAL_DEMO_ACCOUNT=0
LEADS_STORE=postgres
STAFF_SESSION_TTL_HOURS=12
