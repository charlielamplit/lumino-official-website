# 线索通知（可选；未配置时仍落库，Portal 线索箱可查看）
# POST JSON 的 CRM / 飞书机器人 / Zapier / Make 等
LEAD_WEBHOOK_URL=https://example.com/lumino-leads

# Resend 邮件通知（可选，与 Webhook 可并存）
LEAD_NOTIFY_EMAIL=ops@example.com
LEAD_NOTIFY_FROM=Lumino Leads <onboarding@resend.dev>
RESEND_API_KEY=

# 生产环境建议设置；未设置时 GET/PATCH /api/leads 对同源开放（原型）
LEADS_STAFF_KEY=

# GitHub Roadmap / Issue 同步（固定目标仓库）
GITHUB_OWNER=charlielamplit
GITHUB_REPO=lumino-official-website
# 可使用 fine-grained PAT；仅写入本地 .env。
# Repository permissions 至少需要 Metadata: Read 和 Issues: Read and write。
GITHUB_TOKEN=
